<component type="desktop-application">
  <id>io.nextkmail.app</id>
  <name>Next KMail</name>
  <launchable type="desktop-id">next-kmail.desktop</launchable>

  <summary>Cross-platform email client</summary>
  <description>
    <p>Next KMail is a cross-platform email client built with Qt6 / QML, supporting NetEase, Google, and QQ mail.</p>
  </description>

  <project_license>MIT</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <content_rating type="oars-1.1" />

  <developer id="io.nextkmail">
    <name>Next KMail Team</name>
  </developer>

  <url type="homepage">https://github.com/chenph-dev/next-kmail</url>
  <url type="vcs-browser">https://github.com/chenph-dev/next-kmail</url>
  <url type="bugtracker">https://github.com/chenph-dev/next-kmail/issues</url>

  <releases>
    <release version="0.9" date="2026-10-09" />
  </releases>

  <requires>
    <display_length>360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <categories>
    <category>Office</category>
    <category>Email</category>
  </categories>

  <keywords>
    <keyword>email</keyword>
    <keyword>mail</keyword>
    <keyword>qt</keyword>
    <keyword>qml</keyword>
    <keyword>imap</keyword>
  </keywords>
</component>
